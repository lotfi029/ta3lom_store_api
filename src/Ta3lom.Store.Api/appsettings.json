{
  "Store": {
    "PublicBaseUrl": "https://store-api.ta3lom.sa",
    "WebBaseUrl": "https://ta3lom.sa",
    "ForwardedHeaders": {
      "KnownNetworks": [ "172.16.0.0/12" ],
      "KnownProxies": []
    },
    "RateLimits": {
      "Public": { "TokenLimit": 40, "TokensPerPeriod": 2, "ReplenishmentPeriodSeconds": 1 }
    },
    "Telemetry": { "OtlpEndpoint": "" }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Quartz": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
