<Project Sdk="Microsoft.NET.Sdk">
  <!-- Implements the Application ports. Never references Api. -->
  <ItemGroup>
    <ProjectReference Include="../Ta3lom.Store.Application/Ta3lom.Store.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The nightly integrity checks run from code (IntegrityChecks job). -->
    <EmbeddedResource Include="Resources/Integrity/integrity_checks.sql" LogicalName="Integrity.integrity_checks.sql" />
    <!-- Receipt font: Noto Naskh Arabic (SIL OFL 1.1, Resources/Fonts/OFL.txt) — Arabic shaping in the PDF -->
    <EmbeddedResource Include="Resources/Fonts/NotoNaskhArabic-Regular.ttf" LogicalName="Fonts.NotoNaskhArabic-Regular.ttf" />
    <EmbeddedResource Include="Resources/Fonts/NotoNaskhArabic-Bold.ttf" LogicalName="Fonts.NotoNaskhArabic-Bold.ttf" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ta3lom.Store.Api.IntegrationTests" />
    <InternalsVisibleTo Include="Ta3lom.Store.ArchitectureTests" />
  </ItemGroup>
</Project>
