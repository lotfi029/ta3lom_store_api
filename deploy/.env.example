# Copy to deploy/.env and edit. NOT secrets: anything secret goes into deploy/secrets/ (see deploy/secrets.md).
STORE_VERSION=local                      # image tag (e.g. the git commit you deploy)
STORE_ENVIRONMENT=Production             # Production | Staging
API_DOMAIN=store-api.ta3lom.sa
WEB_DOMAIN=store.ta3lom.sa
ACME_EMAIL=ops@ta3lom.sa                 # Let's Encrypt account e-mail (certificate expiry notices)
WEB_DIR=/srv/store-web                   # holds site/ (dist/store-web/browser) and caddy-headers.conf from the web repo
SITE_REBUILD_REPOSITORY=lotfi029/ta3lom_store_web
SMS_SENDER_ID=                           # Unifonic sender id (approved name)
SMTP_USER=store@ta3lom.sa
OTLP_ENDPOINT=                           # optional OpenTelemetry collector
