# Keys the API reads (09 §7). Real values live on the VPS as files under /run/secrets (key = file name,
# "__" separates sections) or as environment variables. Never commit real values.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Store=Host=postgres;Database=ta3lom_store;Username=store_app;Password=<secret>;Search Path=store;Maximum Pool Size=40
Store__DataProtection__KeysPath=/srv/store/keys
# 32 random bytes, base64 (beneficiary mobile_hash HMAC key). Changing it breaks mobile lookups.
Store__Pii__MobileHashKeyBase64=<secret>
Store__Seed__RunOnStartup=true
# Signing keys and peppers (32+ random bytes, base64; each different). Start-up fails in Production when one is
# missing, shorter than 32 bytes or equal to its DEV ONLY value (appsettings.Development.json).
Store__Jwt__CustomerSigningKeyBase64=<secret>
Store__Jwt__StaffSigningKeyBase64=<secret>
Store__Otp__PepperBase64=<secret>
Store__Tokens__StatusKeyBase64=<secret>
Store__Downloads__LinkKeyBase64=<secret>
# SMS: "sink" (log + /dev/sms, non-production) or "unifonic" (needs the approved sender id).
Store__Sms__Provider=unifonic
Store__Sms__AppSid=<secret>
Store__Sms__SenderId=<approved sender id>
# E-mail: "sink" (.eml files in artifacts/mail, /dev/mail) or "smtp" (MailKit; Hostinger 465 implicit TLS).
Store__Email__Mode=smtp
Store__Email__User=store@ta3lom.sa
Store__Email__Password=<secret>
# RUL-49 escalations (empty = the staff alert mailbox)
Store__Email__ManagerAlerts=
# Seller identity printed on invoices and receipts (09 §9.2); the VAT number is the seller_vat_no setting.
Store__Documents__LicenceNo=<association licence number>
