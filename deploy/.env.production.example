# deploy/.env.production — NOT secrets (they live in SECRETS_DIR, see secrets.md). Used with:
#   docker compose --env-file .env.production -p ta3lom-store -f compose.yaml …
COMPOSE_PROJECT_NAME=ta3lom-store
STORE_ENVIRONMENT=Production
STORE_VERSION=1.0.0                         # image tag: X.Y.Z (set by the deploy workflow on each release)
API_DOMAIN=store-api.ta3lom.sa
WEB_DOMAIN=store.ta3lom.sa
EDGE_ALIAS=store-api                        # the edge Caddy proxies store-api.ta3lom.sa → store-api:8080
EDGE_SUBNET=172.31.0.0/24                   # the `edge` network's fixed IPv4 subnet (ta3lom-deploy edge/up.sh)
SECRETS_DIR=./secrets/production
SITE_REBUILD_REPOSITORY=lotfi029/ta3lom_store_web
SMS_SENDER_ID=                              # Unifonic sender id (approved name, Q-12)
SMTP_USER=store@ta3lom.sa
OTLP_ENDPOINT=
