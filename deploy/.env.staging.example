# deploy/.env.staging — NOT secrets. Staging uses Moyasar TEST keys (sk_test_…) and its own database.
#   docker compose --env-file .env.staging -p ta3lom-store-staging -f compose.yaml …
COMPOSE_PROJECT_NAME=ta3lom-store-staging
STORE_ENVIRONMENT=Staging
STORE_VERSION=staging                       # image tag: staging-<sha> (set by the deploy workflow on each main build)
API_DOMAIN=store-api-staging.ta3lom.sa
WEB_DOMAIN=store-staging.ta3lom.sa
EDGE_ALIAS=store-api-staging
EDGE_SUBNET=172.31.0.0/24
SECRETS_DIR=./secrets/staging
SITE_REBUILD_REPOSITORY=lotfi029/ta3lom_store_web
SMS_SENDER_ID=
SMTP_USER=store@ta3lom.sa
OTLP_ENDPOINT=
PAYMENTS_PROVIDER=moyasar                   # showcase: none   (no payments: cart, checkout and finance actions answer 409)
CUSTOMER_SIGNIN=true                        # showcase: false  (no donor sign-in, no SMS; requires PAYMENTS_PROVIDER=none)
