root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,xml,props,targets,csproj,slnx,resx,yml,yaml}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_elsewhere = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error

dotnet_diagnostic.IDE0005.severity = warning      # unnecessary usings
dotnet_diagnostic.CA2007.severity = none          # no ConfigureAwait in ASP.NET Core
dotnet_diagnostic.CA1848.severity = warning       # LoggerMessage source generators
dotnet_diagnostic.CA2016.severity = error         # forward CancellationToken
dotnet_diagnostic.CA1305.severity = error         # explicit culture (money and dates)
dotnet_diagnostic.CA1515.severity = none          # public types are fine in a service's own assemblies
dotnet_diagnostic.CA1711.severity = none          # names such as *EventHandler follow the domain
dotnet_diagnostic.CA1716.severity = none          # `Error` (09 §3.2) only clashes with a VB keyword
dotnet_diagnostic.CA1000.severity = none          # Result<T>.Ok/Fail are the documented factories (09 §3.2)
# Banned APIs (Microsoft.CodeAnalysis.BannedApiAnalyzers, BannedSymbols.txt at the root):
#   DateTime.Now/UtcNow/Today, DateTimeOffset.Now/UtcNow (use IClock), Database.Migrate(Async)
#   BannedSymbols.Money.txt adds System.Double / System.Single in Domain and Contracts.

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none          # Test_method_names_with_underscores
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2000.severity = none          # factories and clients are disposed by xUnit fixtures
dotnet_diagnostic.CA1861.severity = none          # constant arrays in test data
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# EF Core migrations are generated (dotnet ef); analyzers and style rules do not apply.
[src/Ta3lom.Store.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
